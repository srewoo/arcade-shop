{
  "name": "arcade-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:launcher && npm run build:games && npm run verify",
    "build:launcher": "tsc --noEmit && vite build",
    "build:games": "node scripts/build-games.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.6.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}